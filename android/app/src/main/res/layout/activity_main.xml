<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxWidth="170dp"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:adjustViewBounds="true"
                android:contentDescription="BxoStock"
                android:src="@drawable/logo_full" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2E" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:textSize="22sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:adjustViewBounds="true"
                android:contentDescription="BxoStock"
                android:src="@drawable/logo_full" />

            <TextView
                android:id="@+id/tvDrawerUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2E" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp">

                <!-- ===== SALES ===== -->
                <LinearLayout android:id="@+id/gSales" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:orientation="horizontal" android:padding="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Sales" android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/aSales" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▾"
                        android:textColor="?attr/colorPrimary" android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/bSales" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:visibility="gone">
                    <TextView android:id="@+id/dOrders" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Orders" android:textSize="15sp" />
                    <TextView android:id="@+id/dReturns" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Returns" android:textSize="15sp" />
                    <TextView android:id="@+id/dCustomers" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Customers" android:textSize="15sp" />
                </LinearLayout>

                <!-- ===== INVENTORY ===== -->
                <LinearLayout android:id="@+id/gInventory" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:orientation="horizontal" android:padding="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Inventory" android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/aInventory" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="▾"
                        android:textColor="?attr/colorPrimary" android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/bInventory" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:visibility="gone">
                    <TextView android:id="@+id/dProducts" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Products" android:textSize="15sp" />
                    <TextView android:id="@+id/dStock" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Stock in / out" android:textSize="15sp" />
                    <TextView android:id="@+id/dCategories" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Categories" android:textSize="15sp" android:visibility="gone" />
                    <TextView android:id="@+id/dSuppliers" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Suppliers" android:textSize="15sp" android:visibility="gone" />
                    <TextView android:id="@+id/dPurchases" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                        android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                        android:text="Purchase orders" android:textSize="15sp" android:visibility="gone" />
                </LinearLayout>

                <!-- ===== ADMIN (admins only) ===== -->
                <LinearLayout android:id="@+id/adminGroup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout android:id="@+id/gAdmin" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                        android:orientation="horizontal" android:padding="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Admin" android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/aAdmin" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="▾"
                            android:textColor="?attr/colorPrimary" android:textSize="18sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/bAdmin" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:visibility="gone">
                        <TextView android:id="@+id/dUsers" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                            android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                            android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                            android:text="Users" android:textSize="15sp" />
                        <TextView android:id="@+id/dReports" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                            android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                            android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                            android:text="Reports" android:textSize="15sp" />
                        <TextView android:id="@+id/dAudit" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                            android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                            android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                            android:text="Audit logs" android:textSize="15sp" />
                        <TextView android:id="@+id/dStaff" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                            android:clickable="true" android:focusable="true" android:paddingStart="36dp"
                            android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp"
                            android:text="Staff performance" android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/dProfile" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true" android:padding="16dp"
                    android:text="Profile" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Log out" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>