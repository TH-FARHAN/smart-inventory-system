<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="20dp"
        android:text="Sales"
        android:textSize="17sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipPreset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/chip8w"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:text="Last 8 weeks" />
            <com.google.android.material.chip.Chip android:id="@+id/chip6m"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:checked="true"
                android:text="Last 6 months" />
            <com.google.android.material.chip.Chip android:id="@+id/chipYear"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:text="This year" />
            <com.google.android.material.chip.Chip android:id="@+id/chipLastYear"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:text="Last year" />
            <com.google.android.material.chip.Chip android:id="@+id/chipCustom"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:text="Custom" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/customBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button android:id="@+id/btnFrom" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginEnd="4dp" android:layout_weight="1" />
        <Button android:id="@+id/btnTo" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:text="Group bars by"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/chipDay"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:text="Day" />
            <com.google.android.material.chip.Chip android:id="@+id/chipWeek"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:text="Week" />
            <com.google.android.material.chip.Chip android:id="@+id/chipMonth"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:checked="true"
                android:text="Month" />
            <com.google.android.material.chip.Chip android:id="@+id/chipYearG"
                style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:checkable="true" android:text="Year" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFB020"
        android:visibility="gone" />

    <GridLayout
        android:id="@+id/statGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:text="Sales by period (tap a bar for details)"
        android:textStyle="bold" />

    <com.bxostock.app.BarChartView
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="240dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:text="Top products in this period"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/topBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />
</LinearLayout>